// Worker de webhooks de GitHub (Módulo E). Ver README.md antes de desplegar.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qubitor-webhook-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Entregas ya procesadas (X-GitHub-Delivery), para no lanzar dos escaneos por el mismo push.
  // Namespace creado con `npx wrangler kv namespace create DELIVERIES`.
  "kv_namespaces": [
    { "binding": "DELIVERIES", "id": "74ab475c0e3d4bfc96551dc1bc6ad1c5" }
  ],
  "vars": {
    // URL pública de la API de Qubitor en Render, sin barra final.
    "QUBITOR_API_URL": "https://qubitor-api.onrender.com",
    // Repos ("owner/repo", separados por comas) que pueden disparar escaneos. El secreto
    // de GitHub es uno solo para todos los webhooks (QUB-07): esta lista acota a quién
    // afecta si se filtra. Vacía, el Worker no acepta ningún push. Agregar un repo de un
    // cliente es una decisión del equipo, por Pull Request.
    "ALLOWED_REPOSITORIES": "ValentinaPertile/qubitor-demo-vulnerable"
  }
  // Secretos (nunca en este archivo): `npx wrangler secret put GITHUB_WEBHOOK_SECRET`
  // y `npx wrangler secret put INTERNAL_WEBHOOK_SECRET`. En local, en .dev.vars.
}
